# ─── ili Dashboard Configuration ───────────────────────────────────────
# Copy this file to .env and customize for your environment.
# Most settings have sensible defaults for containerized deployment.

# ─── Where ili listens ───────────────────────────────────────────────────
# Host port for the web interface. Default 8080 — ports below 1024 cannot be
# bound by a rootless Docker/Podman user.
# ILI_PORT=8080

# Image version when installing from the registry (ghcr.io/toa1984/ili-dashboard*).
# Default "latest"; pin a release to stay on it across `docker compose pull`.
# ILI_VERSION=0.1.0

# ─── Core Directories (Container paths — do NOT change) ───────────────────
# These point to locations inside the container and should remain as-is.
DASHBOARD_DIR=/app
BOARDS_DIR=/app/boards
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8798

# ─── Domain Configuration (REQUIRED for browser access) ──────────────────
# The domain where ili will be accessible in your network/environment.
# Default: home.arpa (suitable for home networks, requires no DNS).
# For external access or custom domain: set your actual domain name.
DASHBOARD_DOMAIN=home.arpa
# DASHBOARD_DOMAIN=ili.example.com  # Uncomment and customize

# ─── Server URL (Optional) ───────────────────────────────────────────────
# Full URL for external sharing/links. If not set, defaults to http://localhost.
# SERVER_URL=http://localhost:8798

# ─── KI Integration (Optional — not required for basic use) ──────────────
# Local Ollama for experimental KI features.
# Leave unset to disable KI features.
# OLLAMA_URL=http://localhost:11434

# ─── Claude (Optional — not required for basic use) ──────────────────────
# Two ways to give ili access to Claude. Both are optional: without them the
# Kanban core works, and the project terminal will simply offer an interactive
# login on first open (see below).
#
# 1) Anthropic Console API key — pay per use, no login needed anywhere:
# ANTHROPIC_API_KEY=sk-ant-api03-...
#
# 2) Long-lived token for a Claude subscription. Generate it once on a machine
#    that has a browser (`claude setup-token`, valid one year) and paste it here:
# CLAUDE_CODE_OAUTH_TOKEN=...

# ─── Project Terminal (Optional) ─────────────────────────────────────────
# A browser terminal with one tmux session per board and Claude Code inside.
# Not started by default — a browser terminal is full shell access:
#     docker compose -f docker-compose.yml -f docker-compose.terminal.yml up -d
#
# Uncomment the next line and plain `docker compose` commands include the
# terminal from then on (no need to repeat both -f flags). Docker Compose only —
# podman-compose ignores COMPOSE_FILE from this file, there you have to
# `export COMPOSE_FILE=docker-compose.yml:docker-compose.terminal.yml` in your shell:
# COMPOSE_FILE=docker-compose.yml:docker-compose.terminal.yml
#
# The /projterm/ route is always password protected. Leave TERMINAL_PASSWORD
# empty and one is generated on every start and printed to the web container's
# log (docker compose logs web | grep ili-setup). Set it here to keep
# a stable password.
# TERMINAL_USER=ili
# TERMINAL_PASSWORD=
#
# Where the terminal keeps project code. Default: ./projects, one subfolder per
# board. Point it at your own code directory to work on existing projects.
# ILI_PROJECTS_DIR=./projects
