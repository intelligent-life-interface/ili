# Containerfile.terminal — browser terminal for the ili project terminals.
#
# Ships ttyd (browser terminal) + tmux (one persistent session per Kanban board)
# + Claude Code CLI. The web service exposes it under the authenticated
# /projterm/ route; this container publishes NO port of its own on purpose.
#
# Build (from the repository root, not from deploy/):
#   docker compose -f docker-compose.yml -f docker-compose.terminal.yml build terminal
# Node 22 LTS on Debian 13 (Node 20 is end-of-life since 2026-04).
FROM docker.io/library/node:22-trixie-slim

LABEL org.opencontainers.image.title="ili Project Terminal"
LABEL org.opencontainers.image.description="ttyd + tmux + Claude Code, one session per Kanban board"
LABEL org.opencontainers.image.licenses="AGPL-3.0"
LABEL org.opencontainers.image.source="https://github.com/Toa1984/ili-public"
LABEL org.opencontainers.image.url="https://github.com/Toa1984/ili-public"
LABEL org.opencontainers.image.documentation="https://github.com/Toa1984/ili-public/blob/main/QUICKSTART.md"

# ttyd comes as a static binary from the project's releases (asset names match
# `uname -m`: x86_64, aarch64, armhf, ...) — independent of the Debian package.
ARG TTYD_VERSION=1.7.7

# `apt-get upgrade` picks up the security fixes the base image does not carry yet.
# docker-cli, NOT docker.io: on Debian trixie the docker.io package ships only the
# daemon, the client lives in its own package — with docker.io the build fails at
# `docker --version` (exit 127). A daemon has no place here anyway: the terminal
# talks to the sandbox or the host socket via DOCKER_HOST (see
# docker-compose.sandbox.yml / docker-compose.hostdocker.yml).
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
      tmux \
      git \
      curl \
      ca-certificates \
      procps \
      less \
      jq \
      python3 \
      docker-cli \
    && arch="$(uname -m)" \
    && echo "[build] downloading ttyd ${TTYD_VERSION} for ${arch}" \
    && curl -fsSL -o /usr/local/bin/ttyd \
        "https://github.com/tsl0922/ttyd/releases/download/${TTYD_VERSION}/ttyd.${arch}" \
    && chmod +x /usr/local/bin/ttyd \
    && ttyd --version \
    && docker --version \
    && rm -rf /var/lib/apt/lists/*

# Claude Code CLI — the reason the terminal exists. Optional at runtime: without
# credentials the terminal still works as a plain shell.
# The npm bundled with the base image lags behind and drags vulnerable
# dependencies (tar, minimatch, glob, ...) into the image — refresh it first.
# npm >= 12 blocks install scripts by default; Claude Code needs its postinstall
# (downloads the native binary), so allow it for exactly that package.
RUN npm install -g npm@latest \
    && npm install -g --allow-scripts=@anthropic-ai/claude-code @anthropic-ai/claude-code \
    && npm cache clean --force \
    && echo "[build] node $(node --version) npm $(npm --version)" \
    && claude --version

COPY deploy/terminal/entrypoint.sh /usr/local/bin/ili-terminal
COPY deploy/terminal/ili-term.sh   /usr/local/bin/ili-term
COPY deploy/terminal/ili-claude.sh /usr/local/bin/ili-claude
COPY deploy/terminal/ili-login-url-watch.sh /usr/local/bin/ili-login-url-watch
# Claude CLI bridge: HTTP (/chat /vision /stream /health) in front of the logged-in
# Claude Code session. The api container reaches it as http://terminal:8950.
COPY deploy/terminal/claude_cli_bridge.py /usr/local/bin/claude_cli_bridge.py
# Kanban automat (headless Claude workers + ticker), run as the `automat` compose
# service on this same image — see automat/README.md
COPY automat/ /opt/ili-automat/
RUN chmod +x /usr/local/bin/ili-terminal /usr/local/bin/ili-term /usr/local/bin/ili-claude /usr/local/bin/ili-login-url-watch

# Runs as root inside the container by design: with rootless Podman that maps to
# the unprivileged host user, so bind-mounted project files stay writable. Docker
# users who bind-mount host code should override this (see docs/PROJECT-TERMINAL.md).
ENV HOME=/root \
    CLAUDE_CONFIG_DIR=/root/.claude \
    PROJECTS_DIR=/projects \
    BOARDS_DIR=/boards \
    TERMINAL_PORT=7690 \
    TERMINAL_BASE_PATH=/projterm \
    CLAUDE_BIN=/usr/local/bin/claude \
    BRIDGE_HOST=0.0.0.0 \
    BRIDGE_PORT=8950

# /root holds the Claude login (.claude/ + .claude.json) — persist it, otherwise
# every container restart needs a fresh login.
VOLUME ["/root", "/projects"]

EXPOSE 7690 8950

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -fs "http://localhost:${TERMINAL_PORT}${TERMINAL_BASE_PATH}/token" >/dev/null \
     && curl -fs "http://localhost:${BRIDGE_PORT}/health" >/dev/null || exit 1

ENTRYPOINT ["/usr/local/bin/ili-terminal"]
